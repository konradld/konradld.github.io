# Ignore the contents of the _site directory and other cache directories
_site/
.sass-cache/

# Ignore the directory for local files during development
local/

# Ignore the Gemfile that is generated
Gemfile.lock

# Ignore files created by npm
node_modules
package-lock.json

# Ignore the vendor file at root level and bundle for alternative installation
/vendor/
.bundle/

# Ignore folders related to IDEs
.vscode/

# Ignore Claude Code worktrees. These are separate checkouts, so committing one
# records a bare gitlink with no .gitmodules entry, which makes actions/checkout
# fail: "No url found for submodule path ... in .gitmodules".
.claude/worktrees/
